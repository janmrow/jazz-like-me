{
  "name": "jazz-like-me",
  "version": "0.1.0",
  "private": true,
  "description": "Find up to three jazz albums that fit your mood.",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "SERVE_STATIC=false tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "tsc --build tsconfig.build.json && vite build",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
